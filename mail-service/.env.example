# HookDesk is opt-in; existing /send-mail installations keep the original DTO.
HOOKDESK_ENABLED=false
HOOKDESK_SIGNING_SECRET=
HOOKDESK_RECEIPTS_DB=./data/receipts.sqlite3
HOOKDESK_DEMO=false
HOOKDESK_DEMO_ENDPOINT_ID=
HOOKDESK_DEMO_FAILURES=0

MAIL_HOST=localhost
MAIL_PORT=587
MAIL_FROM=
MAIL_USER=
MAIL_PASS=
MAIL_START_TLS=true
MAIL_USE_TLS=false
